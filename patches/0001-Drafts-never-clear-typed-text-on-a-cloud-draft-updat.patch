+    private Runnable draftJournalRunnable;
+
+    private boolean canJournalDraft() {
+        return chatActivityEnterView != null && !chatActivityEnterView.isEditingMessage() && !chatActivityEnterView.isRichDraftActive() && currentEncryptedChat == null
+            && (chatMode == 0 || chatMode == MODE_SAVED && getUserConfig().getClientUserId() == getSavedDialogId());
+    }
+
+    private void scheduleDraftJournal(CharSequence text) {
+        if (!canJournalDraft()) {
+            return;
+        }
+        if (draftJournalRunnable != null) {
+            AndroidUtilities.cancelRunOnUIThread(draftJournalRunnable);
+            draftJournalRunnable = null;
+        }
+        final long did = dialog_id;
+        final long threadId = getDraftThreadId();
+        if (TextUtils.isEmpty(text)) {
+            LocalDraftJournal.remove(currentAccount, did, threadId);
+            return;
+        }
+        draftJournalRunnable = () -> {
+            draftJournalRunnable = null;
+            if (did == dialog_id && threadId == getDraftThreadId()) {
+                writeDraftJournal();
+            }
+        };
+        AndroidUtilities.runOnUIThread(draftJournalRunnable, 300);
+    }
+
+    private void writeDraftJournal() {
+        if (!canJournalDraft()) {
+            return;
+        }
+        CharSequence text = chatActivityEnterView.getFieldText();
+        if (TextUtils.isEmpty(text)) {
+            return;
+        }
+        CharSequence[] message = new CharSequence[]{new SpannableStringBuilder(text)};
+        ArrayList<TLRPC.MessageEntity> entities = getMediaDataController().getEntities(message, true, false);
+        LocalDraftJournal.put(currentAccount, dialog_id, getDraftThreadId(), message[0], entities, !chatActivityEnterView.isMessageWebPageSearchEnabled());
+    }
+
+    private void clearDraftJournal() {
+        if (draftJournalRunnable != null) {
+            AndroidUtilities.cancelRunOnUIThread(draftJournalRunnable);
+            draftJournalRunnable = null;
+        }
+        LocalDraftJournal.remove(currentAccount, dialog_id, getDraftThreadId());
+    }
+
