+package org.telegram.messenger;
+
+import android.app.Activity;
+import android.content.SharedPreferences;
+import android.text.TextUtils;
+
+import org.telegram.tgnet.SerializedData;
+import org.telegram.tgnet.TLRPC;
+
+import java.util.ArrayList;
+
+/**
+ * Local copy of what is typed in the input field, written on every change (debounced by the caller)
+ * so a draft survives a crash, a process kill or a reboot, and so a cloud draft that comes back
+ * shorter (or empty) never replaces the text that was actually typed.
+ * Kept apart from MediaDataController's "drafts" prefs, which cloud draft updates overwrite.
+ */
+public class LocalDraftJournal {
+
+    private static final SharedPreferences[] prefs = new SharedPreferences[UserConfig.MAX_ACCOUNT_COUNT];
+
+    private static SharedPreferences getPrefs(int account) {
+        if (prefs[account] == null) {
+            prefs[account] = ApplicationLoader.applicationContext.getSharedPreferences("nagram_draft_journal" + account, Activity.MODE_PRIVATE);
+        }
+        return prefs[account];
+    }
+
+    private static String key(long dialogId, long threadId) {
+        return dialogId + "_" + threadId;
+    }
+
+    public static void put(int account, long dialogId, long threadId, CharSequence text, ArrayList<TLRPC.MessageEntity> entities, boolean noWebpage) {
+        if (TextUtils.isEmpty(text)) {
+            return;
+        }
+        try {
+            TLRPC.TL_draftMessage draft = new TLRPC.TL_draftMessage();
+            draft.date = (int) (System.currentTimeMillis() / 1000);
+            draft.message = text.toString();
+            draft.no_webpage = noWebpage;
+            if (entities != null && !entities.isEmpty()) {
+                draft.entities = entities;
+                draft.flags |= 8;
+            }
+            SerializedData data = new SerializedData(draft.getObjectSize());
+            draft.serializeToStream(data);
+            getPrefs(account).edit().putString(key(dialogId, threadId), Utilities.bytesToHex(data.toByteArray())).apply();
+            data.cleanup();
+        } catch (Exception e) {
+            FileLog.e(e);
+        }
+    }
+
+    public static TLRPC.DraftMessage get(int account, long dialogId, long threadId) {
+        String hex = getPrefs(account).getString(key(dialogId, threadId), null);
+        if (hex == null) {
+            return null;
+        }
+        try {
+            SerializedData data = new SerializedData(Utilities.hexToBytes(hex));
+            TLRPC.DraftMessage draft = TLRPC.DraftMessage.TLdeserialize(data, data.readInt32(true), true);
+            data.cleanup();
+            if (draft == null || TextUtils.isEmpty(draft.message)) {
+                return null;
+            }
+            return draft;
+        } catch (Exception e) {
+            FileLog.e(e);
+            return null;
+        }
+    }
+
+    public static void remove(int account, long dialogId, long threadId) {
+        SharedPreferences p = getPrefs(account);
+        String k = key(dialogId, threadId);
+        if (p.contains(k)) {
+            p.edit().remove(k).apply();
+        }
+    }
+
+    /**
+     * Picks what goes into the field: the cloud draft, unless the local copy holds text the cloud one
+     * lost (cloud empty, or a shortened copy of the local text, or simply older).
+     * A cloud draft written later on another device with different text still wins.
+     */
+    public static TLRPC.DraftMessage merge(TLRPC.DraftMessage cloud, TLRPC.DraftMessage local) {
+        if (local == null || TextUtils.isEmpty(local.message)) {
+            return cloud;
+        }
+        if (cloud == null || TextUtils.isEmpty(cloud.message)) {
+            if (cloud != null && cloud.reply_to != null) {
+                local.reply_to = cloud.reply_to;
+                local.flags |= 16;
+            }
+            return local;
+        }
+        if (TextUtils.equals(cloud.message, local.message)) {
+            return cloud;
+        }
+        boolean truncated = local.message.startsWith(cloud.message);
+        if (!truncated && cloud.date > local.date + 2) {
+            return cloud;
+        }
+        if (cloud.reply_to != null) {
+            local.reply_to = cloud.reply_to;
+            local.flags |= 16;
+        }
+        if (cloud.effect != 0) {
+            local.effect = cloud.effect;
+            local.flags |= 128;
+        }
+        return local;
+    }
+}
