From 97b3ff771720af467a152f099aa52f9ccf84bd7e Mon Sep 17 00:00:00 2001
From: firestarter1996 <firestarter1996@users.noreply.github.com>
Date: Sat, 17 Oct 2026 13:08:06 -0700
Subject: [PATCH 1/6] Drafts: never clear typed text on a cloud draft update

A draft update for any topic of a forum group called applyDraftMaybe(true), which cleared the
input field whenever the current topic had no stored draft yet (drafts were only stored on
pause or topic switch). Late server echoes of an older save could also replace a newer local
draft, so reopening a topic showed a shortened text.

Now a cloud update never clears the field, and stale server drafts are ignored.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../java/org/telegram/messenger/MediaDataController.java | 9 ++++++++-
 .../src/main/java/org/telegram/ui/ChatActivity.java      | 2 +-
 2 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/MediaDataController.java b/TMessagesProj/src/main/java/org/telegram/messenger/MediaDataController.java
index 8a0e606e..6d70e674 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/MediaDataController.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/MediaDataController.java
@@ -8166,7 +8166,14 @@ public class MediaDataController extends BaseController {
     }
 
     public void saveDraft(long dialogId, long threadId, TLRPC.DraftMessage draft, TLRPC.Message replyToMessage, boolean fromServer) {
-        if (getMessagesController().isForum(dialogId) && threadId == 0 && TextUtils.isEmpty(draft.message)) {
+        if (fromServer && draft != null) {
+            // a late echo of an older save must not replace a newer local draft
+            TLRPC.DraftMessage current = getDraft(dialogId, threadId);
+            if (current != null && draft.date != 0 && draft.date < current.date) {
+                return;
+            }
+        }
+        if (getMessagesController().isForum(dialogId) && threadId == 0 && draft != null && TextUtils.isEmpty(draft.message)) {
             if (draft.reply_to instanceof TLRPC.TL_inputReplyToMessage) {
                 ((TLRPC.TL_inputReplyToMessage) draft.reply_to).reply_to_msg_id = 0;
             }
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
index 9a2003e8..2d44fd4e 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
@@ -24833,7 +24833,7 @@ public class ChatActivity extends BaseFragment implements
         } else if (id == NotificationCenter.newDraftReceived) {
             long did = (Long) args[0];
             if (did == dialog_id) {
-                applyDraftMaybe(true);
+                applyDraftMaybe(false);
             }
         } else if (id == NotificationCenter.pinnedInfoDidLoad) {
             long did = (Long) args[0];
-- 
