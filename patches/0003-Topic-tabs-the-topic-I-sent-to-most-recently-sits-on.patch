+package org.telegram.messenger;
+
+import android.app.Activity;
+import android.content.SharedPreferences;
+
+import org.telegram.tgnet.TLRPC;
+
+import java.util.ArrayList;
+import java.util.Collections;
+
+/**
+ * Remembers when I last sent a message into each forum topic, so the topic tabs can show the topic
+ * I wrote to most recently on the left (right after All and any pinned topics).
+ */
+public class TopicSentOrder {
+
+    private static final SharedPreferences[] prefs = new SharedPreferences[UserConfig.MAX_ACCOUNT_COUNT];
+
+    private static SharedPreferences getPrefs(int account) {
+        if (prefs[account] == null) {
+            prefs[account] = ApplicationLoader.applicationContext.getSharedPreferences("nagram_topic_sent" + account, Activity.MODE_PRIVATE);
+        }
+        return prefs[account];
+    }
+
+    public static void markSent(int account, long chatId, long topicId) {
+        if (topicId == 0) {
+            topicId = 1;
+        }
+        getPrefs(account).edit().putLong(chatId + "_" + topicId, System.currentTimeMillis()).apply();
+    }
+
+    public static long getSent(int account, long chatId, long topicId) {
+        return getPrefs(account).getLong(chatId + "_" + topicId, 0);
+    }
+
+    public static ArrayList<TLRPC.TL_forumTopic> sort(int account, long chatId, ArrayList<TLRPC.TL_forumTopic> topics) {
+        if (topics == null || topics.size() < 2) {
+            return topics;
+        }
+        final ArrayList<TLRPC.TL_forumTopic> sorted = new ArrayList<>(topics);
+        // stable sort: pinned topics keep their order, never used topics keep the server order
+        Collections.sort(sorted, (a, b) -> {
+            if (a.pinned != b.pinned) {
+                return a.pinned ? -1 : 1;
+            }
+            if (a.pinned) {
+                return 0;
+            }
+            return Long.compare(getSent(account, chatId, b.id), getSent(account, chatId, a.id));
+        });
+        return sorted;
+    }
+}
