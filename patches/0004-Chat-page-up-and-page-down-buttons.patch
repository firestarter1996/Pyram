From b1c8e6f4cb6494048ffdd51953e781a8322ef445 Mon Sep 17 00:00:00 2001
From: firestarter1996 <firestarter1996@users.noreply.github.com>
Date: Sat, 17 Oct 2026 08:39:00 -0700
Subject: [PATCH 4/6] Chat: page up and page down buttons

Two small buttons in the side controls scroll the chat by one screen. Each shows only when the
chat can scroll that way.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../java/org/telegram/ui/ChatActivity.java    | 26 ++++++++++++++++++-
 ...ChatActivitySideControlsButtonsLayout.java | 14 +++++++---
 2 files changed, 36 insertions(+), 4 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
index e12cb3fc..96e43573 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
@@ -7242,6 +7242,7 @@ public class ChatActivity extends BaseFragment implements
                 if (chatListThanosEffect != null) {
                     chatListThanosEffect.scroll(dx, dy);
                 }
+                updateScreenPageButtons();
                 scrollUp = dy < 0;
                 int firstVisibleItem = chatLayoutManager.findFirstVisibleItemPosition();
                 if (dy != 0 && (scrollByTouch && recyclerView.getScrollState() == RecyclerView.SCROLL_STATE_SETTLING) || recyclerView.getScrollState() == RecyclerView.SCROLL_STATE_DRAGGING) {
@@ -49344,8 +49345,31 @@ public class ChatActivity extends BaseFragment implements
         }
     }
 
+    private void updateScreenPageButtons() {
+        if (sideControlsButtonsLayout == null || chatListView == null) {
+            return;
+        }
+        final boolean show = chatMode != MODE_SEARCH;
+        sideControlsButtonsLayout.showButton(ChatActivitySideControlsButtonsLayout.BUTTON_SCREEN_UP, show && chatListView.canScrollVertically(-1), true);
+        sideControlsButtonsLayout.showButton(ChatActivitySideControlsButtonsLayout.BUTTON_SCREEN_DOWN, show && chatListView.canScrollVertically(1), true);
+    }
+
+    private void scrollChatByScreen(int direction) {
+        if (chatListView == null) {
+            return;
+        }
+        wasManualScroll = true;
+        final int page = Math.max(dp(100), chatListView.getMeasuredHeight() - (int) chatListViewPaddingTop - blurredViewBottomOffset - dp(96));
+        chatListView.stopScroll();
+        chatListView.smoothScrollBy(0, direction * page);
+    }
+
     private void onSideControlButtonOnClick(int buttonId, View v) {
-        if (buttonId == ChatActivitySideControlsButtonsLayout.BUTTON_PAGE_DOWN) {
+        if (buttonId == ChatActivitySideControlsButtonsLayout.BUTTON_SCREEN_UP) {
+            scrollChatByScreen(-1);
+        } else if (buttonId == ChatActivitySideControlsButtonsLayout.BUTTON_SCREEN_DOWN) {
+            scrollChatByScreen(1);
+        } else if (buttonId == ChatActivitySideControlsButtonsLayout.BUTTON_PAGE_DOWN) {
             onPageDownClicked();
         } else if (buttonId == ChatActivitySideControlsButtonsLayout.BUTTON_MENTION) {
             loadLastUnreadMention();
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Components/chat/layouts/ChatActivitySideControlsButtonsLayout.java b/TMessagesProj/src/main/java/org/telegram/ui/Components/chat/layouts/ChatActivitySideControlsButtonsLayout.java
